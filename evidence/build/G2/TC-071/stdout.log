        pseudo_symbol_body = (
            "# Example: Add a Watermark Annotation\n\n"
            "FQN: Example: Add a Watermark Annotation\n"
            "Kind: verified_example\n"
            "Adds a watermark annotation to a document using a real, verified snippet.\n\n"
