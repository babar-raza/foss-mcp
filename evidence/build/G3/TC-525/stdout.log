        js_mixin_applications: list[dict[str, Any]] = []
        go_const_pairs: list[tuple[str, dict[str, Any]]] = []
        go_composite_types: set[str] = set()
    
        for fpath in files:
            rel = str(fpath.relative_to(repo)).replace("\\", "/")
            files_attempted += 1
            try:
                src = fpath.read_bytes()
            except OSError as e:
