                if _ts_entry_point is not None and item_fpath == _ts_entry_point:
                    return True
                return item_name in _ts_exports
            return True
    
        class_types = _CLASS_TYPES.get(language, set())
        func_types = _FUNC_TYPES.get(language, set())
    
