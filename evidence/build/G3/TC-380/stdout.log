            "source_commit": "cafefeedfacefeed000000000000000000000001",
            "types": [
                {
                    "name": "Sprocket",
                    "class_import": "Example.Widgets.Sprocket",
                    "kind": "class",
                    "doc": "A rotating widget component.",
                    "bases": ["IEnumerable<Cog>", "IDisposable"],
                    "methods": [
