                        "name": name,
                        "inputSchema": {
                            "type": "object",
                            "properties": {a: {"type": "string"} for a in TOOL_ARGUMENTS[name]},
                        },
                    }
                    for name in TOOLS
                ]
    
            def invoke(self, name, arguments):
                return answer(name, arguments)
    
        code = run_gate(
