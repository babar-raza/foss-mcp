# Runtime dependencies for the SERVING image only (Dockerfile.serving).
# Compiled to requirements-serving.lock with hashes:
#   uv pip compile --universal --generate-hashes --output-file requirements-serving.lock requirements-serving.in
#
# Confirmed by a real import scan of the serving path (infra/serve_http.py,
# infra/serve_stdio.py, and everything reachable from them under src/foss_mcp/mcp/,
# src/foss_mcp/indexing/, src/foss_mcp/extraction/{manifest_reader,repo_native_reader,
# github_release_reader}.py, src/foss_mcp/normalization/): the only real third-party
# top-level package imported anywhere on this path is `mcp`. starlette, anyio, and
# pydantic appear only as mcp's own transitive dependencies (mcp.server.lowlevel,
# mcp.server.stdio, mcp.server.transport_security, mcp.types import them, and
# infra/serve_http.py imports starlette directly to build the ASGI app around mcp's
# server) - `uv pip compile` resolves that full transitive closure automatically.
# Dev/ops-only (jsonschema, pytest, ruff, mypy) and extraction/ingestion-only
# (tree-sitter*) packages from requirements.in are deliberately NOT here: the serving
# image never imports them.
mcp

# TC-336: vectorized cosine similarity in src/foss_mcp/indexing/vector_index_writer.py.
# query_vector_index_scored() is called from find_examples.py's vector-based fallback
# stage (TC-331) on every serving query that reaches it - measured directly at
# ~103ms-to-several-seconds under the old pure-Python per-point loop, at real
# pilot-corpus scale (docs/DECISION_LOG.md's 2026-10-10 "NumPy added" entry has the
# full measurement). Needed here, not just in requirements.in's dev/test closure,
# because this scoring path runs inside the serving image itself in production.
numpy

# G3/TC-636 (round-2 remediation, 2026-11-01): src/foss_mcp/indexing/known_defects.py
# (loaded on every serving request through get_product_reference.py, get_symbol.py,
# search_symbols.py and report_index_freshness.py, confirmed by the real import chain
# serve_http.py -> fetch_product_reference.py -> get_product_reference.py ->
# known_defects.py) parses config/known_defects/*.yaml with `import yaml` at module
# load time - this was missed when TC-636 landed (the module was dormant/unwired then)
# and caused the serving image to crash on startup for every pilot
# (ModuleNotFoundError: No module named 'yaml') the moment KD2 (TC-639) wired it into
# the real import chain. Caught by image_workflow_gate.py before any push.
pyyaml
