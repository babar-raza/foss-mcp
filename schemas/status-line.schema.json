{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/foss-mcp/schemas/status-line.schema.json",
  "title": "foss-mcp worker status line",
  "description": "One line of ops/status.jsonl. Appended ONLY via `gatectl status-append`, which fills ts and commit itself. No model ever types these two fields - that is the structural fix for fabricated timestamps and for the observed `commit: null` drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "card", "phase", "verdict", "summary", "commit", "attempt"],
  "properties": {
    "ts":      {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "card":    {"type": "string", "pattern": "^(TC-[0-9]{3}[a-z]?|SESSION)$"},
    "phase":   {"enum": ["started", "committed", "blocked", "new_defect", "provisional", "ended"]},
    "verdict": {"enum": ["pass", "fail", "n/a"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "commit":  {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
