{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/foss-mcp/schemas/receipt.schema.json",
  "title": "foss-mcp verification receipt",
  "description": "evidence/build/<gate>/<card>/receipt.json. Written ONLY by `gatectl verify`. A receipt is a CACHE, not an authority: gate-exit re-runs verify from scratch and ignores stored receipts. accepted is true only when the clean run passed AND the negative-control run failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card",
    "gate",
    "generated_by",
    "generated_at",
    "base_rev",
    "head_rev",
    "fingerprint",
    "scope",
    "runs",
    "negative_control",
    "accepted"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "card": {
      "type": "string",
      "pattern": "^TC-[0-9]{3}[a-z]?$"
    },
    "gate": {
      "type": "string",
      "pattern": "^G[0-5]$"
    },
    "generated_by": {
      "const": "gatectl"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "base_rev": {
      "$ref": "#/$defs/sha40"
    },
    "head_rev": {
      "$ref": "#/$defs/sha40"
    },
    "card_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fingerprint": {
      "description": "Machine-comparable, not prose. A rerun whose fingerprint differs is flagged, never silently accepted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "lock_sha256",
        "env"
      ],
      "properties": {
        "python": {
          "$ref": "#/$defs/text"
        },
        "platform": {
          "$ref": "#/$defs/text"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "changed_paths",
        "violations"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluated": {
          "type": "boolean",
          "description": "False on a gate-exit re-verification: scope is a dispatch-time property, settled when the card was accepted against its own base. Re-checking it against a base spanning every later commit would be meaningless."
        }
      }
    },
    "runs": {
      "description": "The clean check set, executed TWICE. Disagreement between run 1 and run 2 is a flake and fails the card.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run",
          "checks",
          "all_passed"
        ],
        "properties": {
          "run": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "all_passed": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command",
                "exit_code",
                "duration_s",
                "stdout_sha256"
              ],
              "properties": {
                "command": {
                  "$ref": "#/$defs/text"
                },
                "exit_code": {
                  "type": "integer"
                },
                "duration_s": {
                  "type": "number",
                  "minimum": 0
                },
                "stdout_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "tests": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "failures": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "negative_control": {
      "description": "The falsifier and its outcome. patch_applied_failed MUST be true: if the card's own checks still pass once the thing it built is broken, those checks prove nothing. `patch` holds the patch path or the mutation command.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "patch",
        "patch_sha256",
        "applied",
        "patch_applied_failed"
      ],
      "properties": {
        "patch": {
          "type": "string",
          "minLength": 1
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "applied": {
          "type": "boolean"
        },
        "patch_applied_failed": {
          "type": "boolean"
        },
        "exit_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "kind": {
          "enum": [
            "patch",
            "mutate"
          ]
        },
        "tree_changed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths the falsifier actually mutated. Empty means it did nothing, however it exited."
        }
      }
    },
    "accepted": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ran",
        "passed",
        "detail"
      ],
      "description": "Supervisor-authored checks the card does not name, run from evidence/holdout/<card>/. A card's own suite is written by the same worker as the code, so both can agree on a wrong idea while every declared check passes.",
      "properties": {
        "ran": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
