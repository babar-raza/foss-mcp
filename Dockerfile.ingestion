# Ingestion image: a plain CLI entry point that publishes one generation through the CAS
# manifest path. Deliberately not called "worker" - there is no message broker in this
# architecture for it to work against; it runs once, publishes, and exits.
#
# Exactly one of the two build paths this project ships (the other is Dockerfile.serving).
# Do NOT add a third: an unreferenced alternate Dockerfile is a confirmed crash-loop trap in
# the reference system, still sitting unused in its tree.
FROM python:3.13-slim@sha256:b92e6b9bb1ea9d826e9956fd8d30bf18bc384c130231d74fdf0ba3460c290b0b

WORKDIR /app

# REQ-G2-048 (TC-069): the real verified-example path (infra/build_chunks.py's
# --furnished-page/--library-* flags, TC-068) needs a real git (to clone the pinned
# reference library) and a real .NET 8 SDK (to really compile each candidate example) -
# neither is present in this image's plain python:3.13-slim base. Debian trixie's own apt
# repos do not reliably carry a current dotnet-sdk-8.0 package, so Microsoft's own,
# officially supported dotnet-install.sh script is used instead (more reliable across
# base-image releases than chasing distro packaging):
# https://learn.microsoft.com/dotnet/core/tools/dotnet-install-script
#
# DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 is required on this slim base: without it the
# installed SDK aborts at startup with "Couldn't find a valid ICU package installed on the
# system" (confirmed by hand against this exact image) rather than pull in a whole ICU data
# package for a one-shot CLI that never needs locale-aware formatting.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh
ENV PATH="/usr/share/dotnet:${PATH}" \
    DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# REQ-G2-048 (TC-097): pdf/typescript's ingestion path (build_chunks.py's
# --library-typescript flag) needs Node.js + npm to run `npx tsc` against candidate
# examples. Checked apt-cache policy on this exact base image first: trixie's own
# nodejs package resolves to 20.19.2 ("Iron"), a line already past Node's own Active
# LTS window by the time this card was written (confirmed against
# https://nodejs.org/dist/index.json's own LTS entries - the current Active LTS is
# Node 24 "Krypton"). The same "distro package is stale" situation as dotnet above,
# so Node's own officially published Linux tarball is used instead; npm ships
# bundled inside it, so no separate npm install/package is needed. .tar.gz (not
# .tar.xz) is used because this slim base has no `xz` binary and GNU tar here has no
# built-in liblzma support, only zlib (gzip) - confirmed by hand against this exact
# image.
# TC-174: the version and the sha256 are pinned to scripts/toolchain/toolchain.lock.json, taken
# from https://nodejs.org/dist/v24.13.1/SHASUMS256.txt. Any other version fails the checksum.
ARG NODE_VERSION=24.13.1
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -o /tmp/node.tar.gz \
    && echo "7ad28fb172a9ab0593f86c1a39e5c268d0d8fc3d6cb0167f455b5655a7a6e2fd  /tmp/node.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.gz

# REQ-G2-048 (TC-097): pdf/java's ingestion path needs a JDK (11+) and Maven to
# `mvn`-compile candidate examples. Unlike Node/Go/Rust's fast release cadence,
# OpenJDK ships multi-year LTS lines - trixie's own openjdk-21-jdk (21.0.12, an
# actively supported LTS release) and its own maven (3.9.9, the current 3.x line)
# are both genuinely current, confirmed by apt-cache policy against this exact base
# image, so apt is used directly here (this project's own stated preference
# whenever the distro package really is current enough).
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jdk maven \
    && rm -rf /var/lib/apt/lists/*

# REQ-G2-048 (TC-097): pdf/go's ingestion path needs a real Go toolchain to
# `go build`/`go vet` candidate examples. trixie's own golang-go package resolves to
# 1.24 (~early 2025), already behind upstream's current 1.27 line (confirmed against
# https://go.dev/VERSION?m=text) - the same "distro package is stale" situation as
# dotnet and Node above. go.dev's own official Linux tarball is used instead.
# TC-174: pinned to the host toolchain version in toolchain.lock.json (go 1.26.4). The sha256 is
# the linux-amd64 archive checksum from the official https://go.dev/dl/?mode=json&include=all.
ARG GO_VERSION=1.26.4
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && echo "1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f  /tmp/go.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/go.tar.gz -C /usr/local \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# REQ-G2-048 (TC-097): cells/rust's ingestion path needs a real Rust toolchain
# (rustc + cargo) AND a system C linker - even a pure-Rust crate needs one on Linux.
# trixie's own rustc/cargo resolve to 1.85.1 (~Feb 2025), already well behind
# upstream's current 1.98 line (confirmed against https://endoflife.date/rust) - the
# same "distro package is stale" situation as dotnet, Node, and Go above. Rust's own
# official rustup.rs install script is used instead (non-interactive -y), installed
# into a shared location (not the default $HOME/.cargo) so the non-root foss-mcp
# user created below can use it too - the same pattern the official Rust Docker
# image itself uses. build-essential supplies the linker (cc/ld) rustc needs at
# link time, even for a pure-Rust crate.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
# TC-174: the toolchain is pinned by RUST_VERSION (the host cargo version in toolchain.lock.json),
# not the floating "stable" channel. rustup-init is fetched as a binary and checked by sha256
# against https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init.sha256.
ARG RUST_VERSION=1.98.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -fsSL https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init -o /tmp/rustup-init \
    && echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "${RUST_VERSION}" --no-modify-path \
    && rm /tmp/rustup-init \
    && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME"

# REQ-G2-043 (TC-222): pdf/cpp's ingestion path (build_chunks.py's --library-platform cpp) builds the
# pinned library with CMake and compiles each candidate example with g++ (-std=c++20). Both come from
# Debian trixie's own repos, which carry the same line the 2026-10-04 feasibility build used: g++ 14
# (package g++ 4:14.2.0-1, gcc-14 14.2.0-19) and CMake 3.31 (cmake 3.31.6-2), confirmed against
# deb.debian.org's trixie index. apt is used directly, as for openjdk and maven above, so both float with
# the trixie mirror and are not pinned to a snapshot date. The versions are recorded here; toolchain.lock.json
# does not carry a row for them yet (outside TC-222's write_paths). make is supplied by build-essential below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ cmake \
    && rm -rf /var/lib/apt/lists/*

# Hash-verified install: every dependency, and its transitive closure, is pinned by exact
# sha256 in requirements.lock. --require-hashes refuses to install anything that isn't.
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# TC-176: the tree-sitter grammars are downloaded HERE, at build time, while the build has network
# access. tree_sitter_language_pack 1.16.1 otherwise fetches its manifest and grammar shared objects
# from GitHub on the first get_parser() call, and an offline container then fails with DownloadError.
# The cache base is read from the installed package (tree_sitter_language_pack 1.16.1, cache_dir()
# and the native module's own error text): TREE_SITTER_LANGUAGE_PACK_CACHE_DIR overrides the platform
# default (XDG_CACHE_HOME / HOME on Linux), and the pack writes manifest.json, bundles/ and
# libs/ under <base>/tree-sitter-language-pack/v1.16.1/. The language set is the seven keys of
# src/foss_mcp/extraction/tree_sitter_engine/lang/__init__.py LANGUAGES. A failed load fails this RUN.
# The pack refuses a cache directory owned by a uid other than the running process, and the runtime
# user foss-mcp is uid 10001 (created below), so the baked directory is chowned to that uid.
ENV TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=/opt/tree-sitter-cache
RUN python -c "from tree_sitter_language_pack import get_parser as g; names = ('python', 'rust', 'csharp', 'typescript', 'java', 'cpp', 'go'); [g(n) for n in names]; print('baked tree-sitter grammars:', ' '.join(names))" \
    && chown -R 10001:10001 /opt/tree-sitter-cache \
    && chmod -R a+rX /opt/tree-sitter-cache

# foss_mcp has no [build-system] in pyproject.toml (src/ layout only, per docs/REPOSITORY_LAYOUT.md);
# it is placed on PYTHONPATH rather than pip-installed, the same way tests/conftest.py does it locally.
COPY src/ ./src/
COPY config/ ./config/
COPY infra/ingest.py ./infra/ingest.py
COPY infra/build_chunks.py ./infra/build_chunks.py
COPY infra/fetch_product_reference.py ./infra/fetch_product_reference.py
COPY infra/fetch_recent_releases.py ./infra/fetch_recent_releases.py
COPY infra/verify_package_registry.py ./infra/verify_package_registry.py
COPY infra/verify_product_reference_install.py ./infra/verify_product_reference_install.py
COPY tests/fixtures/pdf_net/api_surface.json ./fixtures/pdf_net/api_surface.json
# REQ-G2-048 (TC-069): the furnished-content page --furnished-page reads from, real inside
# the container - the same real, committed fixture TC-068's own host-level test already
# proved against.
COPY tests/fixtures/furnished/pdf_net/pages/_index.md ./fixtures/furnished/pdf_net/pages/_index.md

# REQ-G2-050 (TC-103): the same two fixture files as pdf/net above, for each of the 5
# remaining original pilots - TC-098's own worker found that this image only ever COPYed
# pdf/net's own fixtures, so every other pilot's ingest-<pilot> compose service failed
# immediately with FileNotFoundError. Purely additive; pdf/net's own lines above are
# untouched.
COPY tests/fixtures/pdf_typescript/api_surface.json ./fixtures/pdf_typescript/api_surface.json
COPY tests/fixtures/furnished/pdf_typescript/pages/_index.md ./fixtures/furnished/pdf_typescript/pages/_index.md
COPY tests/fixtures/pdf_java/api_surface.json ./fixtures/pdf_java/api_surface.json
COPY tests/fixtures/furnished/pdf_java/pages/_index.md ./fixtures/furnished/pdf_java/pages/_index.md
COPY tests/fixtures/pdf_go/api_surface.json ./fixtures/pdf_go/api_surface.json
COPY tests/fixtures/furnished/pdf_go/pages/_index.md ./fixtures/furnished/pdf_go/pages/_index.md
COPY tests/fixtures/slides_python/api_surface.json ./fixtures/slides_python/api_surface.json
COPY tests/fixtures/furnished/slides_python/pages/_index.md ./fixtures/furnished/slides_python/pages/_index.md
COPY tests/fixtures/cells_rust/api_surface.json ./fixtures/cells_rust/api_surface.json
COPY tests/fixtures/furnished/cells_rust/pages/_index.md ./fixtures/furnished/cells_rust/pages/_index.md
# REQ-G2-044 (TC-172): pdf/cpp's API-surface fixture for the ingest-pdf-cpp compose service.
# Only api_surface.json: pdf/cpp has no furnished page, since no cpp example path exists.
COPY tests/fixtures/pdf_cpp/api_surface.json ./fixtures/pdf_cpp/api_surface.json
# REQ-G2-043 (TC-209): the second-product POC pilots. These are self-extracted, so each has only an
# api_surface.json and no furnished page.
COPY tests/fixtures/words_python/api_surface.json ./fixtures/words_python/api_surface.json
COPY tests/fixtures/words_net/api_surface.json ./fixtures/words_net/api_surface.json
COPY tests/fixtures/slides_java/api_surface.json ./fixtures/slides_java/api_surface.json
COPY tests/fixtures/cells_go/api_surface.json ./fixtures/cells_go/api_surface.json
COPY tests/fixtures/cells_typescript/api_surface.json ./fixtures/cells_typescript/api_surface.json
COPY tests/fixtures/jmap_rust/api_surface.json ./fixtures/jmap_rust/api_surface.json
COPY tests/fixtures/cells_cpp/api_surface.json ./fixtures/cells_cpp/api_surface.json
# REQ-G2-043 (TC-227): six more self-extracted POC pilots, growing the chart from fourteen pilots
# to twenty. Each has only an api_surface.json and no furnished page.
COPY tests/fixtures/cells_net/api_surface.json ./fixtures/cells_net/api_surface.json
COPY tests/fixtures/cells_python/api_surface.json ./fixtures/cells_python/api_surface.json
COPY tests/fixtures/jmap_python/api_surface.json ./fixtures/jmap_python/api_surface.json
COPY tests/fixtures/pdf_python/api_surface.json ./fixtures/pdf_python/api_surface.json
COPY tests/fixtures/slides_cpp/api_surface.json ./fixtures/slides_cpp/api_surface.json
COPY tests/fixtures/slides_net/api_surface.json ./fixtures/slides_net/api_surface.json
# REQ-G2-043 (TC-231): eight more self-extracted POC pilots, growing the chart from twenty
# pilots to twenty-eight. Each has only an api_surface.json and no furnished page.
COPY tests/fixtures/email_python/api_surface.json ./fixtures/email_python/api_surface.json
COPY tests/fixtures/email_cpp/api_surface.json ./fixtures/email_cpp/api_surface.json
COPY tests/fixtures/email_net/api_surface.json ./fixtures/email_net/api_surface.json
COPY tests/fixtures/barcode_python/api_surface.json ./fixtures/barcode_python/api_surface.json
COPY tests/fixtures/note_python/api_surface.json ./fixtures/note_python/api_surface.json
COPY tests/fixtures/html_python/api_surface.json ./fixtures/html_python/api_surface.json
COPY tests/fixtures/page_python/api_surface.json ./fixtures/page_python/api_surface.json
COPY tests/fixtures/imaging_net/api_surface.json ./fixtures/imaging_net/api_surface.json
# REQ-G2-043 (TC-235): seven more self-extracted POC pilots, growing the chart from
# twenty-eight pilots to thirty-five. Each has only an api_surface.json and no furnished page.
COPY tests/fixtures/cells_java/api_surface.json ./fixtures/cells_java/api_surface.json
COPY tests/fixtures/jmap_typescript/api_surface.json ./fixtures/jmap_typescript/api_surface.json
COPY tests/fixtures/jmap_go/api_surface.json ./fixtures/jmap_go/api_surface.json
COPY tests/fixtures/jmap_net/api_surface.json ./fixtures/jmap_net/api_surface.json
COPY tests/fixtures/jmap_cpp/api_surface.json ./fixtures/jmap_cpp/api_surface.json
COPY tests/fixtures/jmap_java/api_surface.json ./fixtures/jmap_java/api_surface.json
COPY tests/fixtures/jmap_nodejs/api_surface.json ./fixtures/jmap_nodejs/api_surface.json
# REQ-G2-043 (TC-236): the last five self-extracted POC pilots, growing the chart from
# thirty-five pilots to forty. Each has only an api_surface.json and no furnished page.
COPY tests/fixtures/3d_python/api_surface.json ./fixtures/3d_python/api_surface.json
COPY tests/fixtures/3d_typescript/api_surface.json ./fixtures/3d_typescript/api_surface.json
COPY tests/fixtures/3d_net/api_surface.json ./fixtures/3d_net/api_surface.json
COPY tests/fixtures/3d_java/api_surface.json ./fixtures/3d_java/api_surface.json
COPY tests/fixtures/tex_python/api_surface.json ./fixtures/tex_python/api_surface.json
ENV PYTHONPATH=/app/src

# Same fix as Dockerfile.serving's own /data/manifests (TC-019a): the non-root user below
# cannot create a top-level /data at runtime, so a volume mounted at /data/manifests for this
# one-shot ingestion service needs the mountpoint to already exist, owned by foss-mcp, in the
# image - otherwise Docker populates a fresh named volume from this directory's own on-image
# ownership (root), and the first real write inside the container fails with PermissionError.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin foss-mcp \
    && mkdir -p /data/manifests \
    && chown -R foss-mcp:foss-mcp /data
USER foss-mcp

# A one-shot CLI has no long-running server to poll; this confirms the deployed environment
# itself is intact (the publish path this entry point depends on actually imports).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import foss_mcp.indexing.publisher"]

ENTRYPOINT ["python", "/app/infra/ingest.py"]
