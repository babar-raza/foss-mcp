# Ingestion image: a plain CLI entry point that publishes one generation through the CAS
# manifest path. Deliberately not called "worker" - there is no message broker in this
# architecture for it to work against; it runs once, publishes, and exits.
#
# Exactly one of the two build paths this project ships (the other is Dockerfile.serving).
# Do NOT add a third: an unreferenced alternate Dockerfile is a confirmed crash-loop trap in
# the reference system, still sitting unused in its tree.
FROM python:3.13-slim

WORKDIR /app

# REQ-G2-048 (TC-069): the real verified-example path (infra/build_chunks.py's
# --furnished-page/--library-* flags, TC-068) needs a real git (to clone the pinned
# reference library) and a real .NET 8 SDK (to really compile each candidate example) -
# neither is present in this image's plain python:3.13-slim base. Debian trixie's own apt
# repos do not reliably carry a current dotnet-sdk-8.0 package, so Microsoft's own,
# officially supported dotnet-install.sh script is used instead (more reliable across
# base-image releases than chasing distro packaging):
# https://learn.microsoft.com/dotnet/core/tools/dotnet-install-script
#
# DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 is required on this slim base: without it the
# installed SDK aborts at startup with "Couldn't find a valid ICU package installed on the
# system" (confirmed by hand against this exact image) rather than pull in a whole ICU data
# package for a one-shot CLI that never needs locale-aware formatting.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh
ENV PATH="/usr/share/dotnet:${PATH}" \
    DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# REQ-G2-048 (TC-097): pdf/typescript's ingestion path (build_chunks.py's
# --library-typescript flag) needs Node.js + npm to run `npx tsc` against candidate
# examples. Checked apt-cache policy on this exact base image first: trixie's own
# nodejs package resolves to 20.19.2 ("Iron"), a line already past Node's own Active
# LTS window by the time this card was written (confirmed against
# https://nodejs.org/dist/index.json's own LTS entries - the current Active LTS is
# Node 24 "Krypton"). The same "distro package is stale" situation as dotnet above,
# so Node's own officially published Linux tarball is used instead; npm ships
# bundled inside it, so no separate npm install/package is needed. .tar.gz (not
# .tar.xz) is used because this slim base has no `xz` binary and GNU tar here has no
# built-in liblzma support, only zlib (gzip) - confirmed by hand against this exact
# image.
ARG NODE_VERSION=24.21.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -o /tmp/node.tar.gz \
    && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.gz

# REQ-G2-048 (TC-097): pdf/java's ingestion path needs a JDK (11+) and Maven to
# `mvn`-compile candidate examples. Unlike Node/Go/Rust's fast release cadence,
# OpenJDK ships multi-year LTS lines - trixie's own openjdk-21-jdk (21.0.12, an
# actively supported LTS release) and its own maven (3.9.9, the current 3.x line)
# are both genuinely current, confirmed by apt-cache policy against this exact base
# image, so apt is used directly here (this project's own stated preference
# whenever the distro package really is current enough).
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jdk maven \
    && rm -rf /var/lib/apt/lists/*

# REQ-G2-048 (TC-097): pdf/go's ingestion path needs a real Go toolchain to
# `go build`/`go vet` candidate examples. trixie's own golang-go package resolves to
# 1.24 (~early 2025), already behind upstream's current 1.27 line (confirmed against
# https://go.dev/VERSION?m=text) - the same "distro package is stale" situation as
# dotnet and Node above. go.dev's own official Linux tarball is used instead.
ARG GO_VERSION=1.27.1
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz \
    && tar -xzf /tmp/go.tar.gz -C /usr/local \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# REQ-G2-048 (TC-097): cells/rust's ingestion path needs a real Rust toolchain
# (rustc + cargo) AND a system C linker - even a pure-Rust crate needs one on Linux.
# trixie's own rustc/cargo resolve to 1.85.1 (~Feb 2025), already well behind
# upstream's current 1.98 line (confirmed against https://endoflife.date/rust) - the
# same "distro package is stale" situation as dotnet, Node, and Go above. Rust's own
# official rustup.rs install script is used instead (non-interactive -y), installed
# into a shared location (not the default $HOME/.cargo) so the non-root foss-mcp
# user created below can use it too - the same pattern the official Rust Docker
# image itself uses. build-essential supplies the linker (cc/ld) rustc needs at
# link time, even for a pure-Rust crate.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && chmod +x /tmp/rustup-init.sh \
    && /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable --no-modify-path \
    && rm /tmp/rustup-init.sh \
    && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME"

# Hash-verified install: every dependency, and its transitive closure, is pinned by exact
# sha256 in requirements.lock. --require-hashes refuses to install anything that isn't.
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# foss_mcp has no [build-system] in pyproject.toml (src/ layout only, per docs/REPOSITORY_LAYOUT.md);
# it is placed on PYTHONPATH rather than pip-installed, the same way tests/conftest.py does it locally.
COPY src/ ./src/
COPY config/ ./config/
COPY infra/ingest.py ./infra/ingest.py
COPY infra/build_chunks.py ./infra/build_chunks.py
COPY tests/fixtures/pdf_net/api_surface.json ./fixtures/pdf_net/api_surface.json
# REQ-G2-048 (TC-069): the furnished-content page --furnished-page reads from, real inside
# the container - the same real, committed fixture TC-068's own host-level test already
# proved against.
COPY tests/fixtures/furnished/pdf_net/pages/_index.md ./fixtures/furnished/pdf_net/pages/_index.md

# REQ-G2-050 (TC-103): the same two fixture files as pdf/net above, for each of the 5
# remaining original pilots - TC-098's own worker found that this image only ever COPYed
# pdf/net's own fixtures, so every other pilot's ingest-<pilot> compose service failed
# immediately with FileNotFoundError. Purely additive; pdf/net's own lines above are
# untouched.
COPY tests/fixtures/pdf_typescript/api_surface.json ./fixtures/pdf_typescript/api_surface.json
COPY tests/fixtures/furnished/pdf_typescript/pages/_index.md ./fixtures/furnished/pdf_typescript/pages/_index.md
COPY tests/fixtures/pdf_java/api_surface.json ./fixtures/pdf_java/api_surface.json
COPY tests/fixtures/furnished/pdf_java/pages/_index.md ./fixtures/furnished/pdf_java/pages/_index.md
COPY tests/fixtures/pdf_go/api_surface.json ./fixtures/pdf_go/api_surface.json
COPY tests/fixtures/furnished/pdf_go/pages/_index.md ./fixtures/furnished/pdf_go/pages/_index.md
COPY tests/fixtures/slides_python/api_surface.json ./fixtures/slides_python/api_surface.json
COPY tests/fixtures/furnished/slides_python/pages/_index.md ./fixtures/furnished/slides_python/pages/_index.md
COPY tests/fixtures/cells_rust/api_surface.json ./fixtures/cells_rust/api_surface.json
COPY tests/fixtures/furnished/cells_rust/pages/_index.md ./fixtures/furnished/cells_rust/pages/_index.md
ENV PYTHONPATH=/app/src

# Same fix as Dockerfile.serving's own /data/manifests (TC-019a): the non-root user below
# cannot create a top-level /data at runtime, so a volume mounted at /data/manifests for this
# one-shot ingestion service needs the mountpoint to already exist, owned by foss-mcp, in the
# image - otherwise Docker populates a fresh named volume from this directory's own on-image
# ownership (root), and the first real write inside the container fails with PermissionError.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin foss-mcp \
    && mkdir -p /data/manifests \
    && chown -R foss-mcp:foss-mcp /data
USER foss-mcp

# A one-shot CLI has no long-running server to poll; this confirms the deployed environment
# itself is intact (the publish path this entry point depends on actually imports).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import foss_mcp.indexing.publisher"]

ENTRYPOINT ["python", "/app/infra/ingest.py"]
