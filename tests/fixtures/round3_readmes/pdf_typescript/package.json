{
  "name": "@asposefoss/pdf",
  "version": "0.1.0",
  "description": "A zero-dependency TypeScript library for reading, manipulating, and writing PDF files in Node.js.",
  "keywords": [
    "pdf",
    "typescript",
    "acroform",
    "pdf-generation",
    "pdf-parser",
    "text-extraction",
    "tagged-pdf",
    "pdfa",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Aspose Pty Ltd",
  "homepage": "https://github.com/aspose-pdf-foss/Aspose.PDF-FOSS-for-TypeScript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspose-pdf-foss/Aspose.PDF-FOSS-for-TypeScript.git"
  },
  "bugs": {
    "url": "https://github.com/aspose-pdf-foss/Aspose.PDF-FOSS-for-TypeScript/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md",
    "fonts/LICENSE-OFL.txt",
    "fonts/LICENSE-URW-AGPL.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "gen:fonts": "node scripts/gen-std14-fonts.mjs",
    "gen:ucd": "node scripts/gen-ucd.mjs",
    "gen:entities": "node scripts/gen-entities.mjs",
    "example:showcase": "tsx examples/feature-showcase/main.ts",
    "gen:cmaps": "tsx scripts/gen-cmaps.ts",
    "gen:icc": "node scripts/gen-icc-fixture.mjs",
    "gen:cidunicode": "tsx scripts/gen-cidunicode.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "gen:dfont": "node scripts/gen-dfont-fixture.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
