#!/bin/sh
# POSIX sh on purpose, with an absolute shebang: `#!/usr/bin/env bash` searches PATH, and on a
# Windows host the first `bash` on PATH can be C:/Windows/System32/bash.exe, the WSL launcher. GitHub
# Desktop's bundled git ships sh.exe but no bash.exe, so there that launcher was the only candidate and
# every commit and push died with "WSL Relay ... execvpe(/bin/bash) failed" (found 2026-10-06).
# /bin/sh is resolved by git's own runtime, never by PATH. Keep this file POSIX (no pipefail, no [[ ]]).
# Refuses a commit that would sweep up work the committer does not own.
#
# This is a HOOK and not a command because the command already existed, already
# printed the right refusal, and was chained past with `;` - twice. A control the
# operator can step over is a suggestion.
#
# Delegates to `gatectl commit-guard` rather than re-deriving the check here -
# two implementations of the same rule can drift, and one already did (this
# hook used to inline its own path check, separately from the command).
#
# A worker commits its own card. It names the card in FOSS_MCP_WORKER, for
# example FOSS_MCP_WORKER=TC-186, and the guard then allows only staged paths
# inside that card's write_paths, with an open dispatch on the channel. The old
# value 1 used to skip the guard for every path. It now fails, because no card
# is named.
set -eu

# Fails closed if this clone's own LOCAL git config overrides user.email/user.name, or sets
# core.bare=true - this project has no legitimate reason to ever set any of these locally;
# the only way they get set is exactly the leaked-GIT_DIR class of bug (an ambient GIT_DIR
# from a linked worktree redirecting a test fixture's own `git init`/`git config` onto the
# real repo) that corrupted this repo's shared .git/config on 2026-10-10, including making
# this checkout bare, and misattributed over a dozen real commits (see docs/DECISION_LOG.md).
# A real identity always comes from the global config alone - checked BEFORE anything else in
# this hook, including resolving MAIN_ROOT below, so a corrupted config can never slip a
# misattributed commit through on a technicality.
if git config --local --get user.email >/dev/null 2>&1; then
  echo >&2
  echo "pre-commit: BLOCKED - this repo's LOCAL git config sets user.email. Local config" >&2
  echo "overrides the global identity and must never be set here. Run:" >&2
  echo "  git config --unset user.email" >&2
  echo "then re-check with: git config --list --show-origin" >&2
  exit 1
fi
if git config --local --get user.name >/dev/null 2>&1; then
  echo >&2
  echo "pre-commit: BLOCKED - this repo's LOCAL git config sets user.name (same issue as" >&2
  echo "user.email above - local config must never set an identity here). Run:" >&2
  echo "  git config --unset user.name" >&2
  exit 1
fi
if [ "$(git config --get core.bare 2>/dev/null || true)" = "true" ]; then
  echo >&2
  echo "pre-commit: BLOCKED - core.bare=true in this repo's own config. A real working" >&2
  echo "checkout must never be bare - this is the same leaked-GIT_DIR corruption recorded" >&2
  echo "in docs/DECISION_LOG.md's 2026-10-10 entry. Run:" >&2
  echo "  git config core.bare false" >&2
  exit 1
fi

# The venv lives in the main checkout. A worktree has none, so resolve the main root from
# the common git dir, which is the same from every worktree (TC-184 worker, 2026-10-04).
MAIN_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
PY="$MAIN_ROOT/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$MAIN_ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="python"

if [ -n "${FOSS_MCP_WORKER:-}" ]; then
  if ! "$PY" ops/gatectl.py commit-guard --worker "$FOSS_MCP_WORKER"; then
    echo >&2
    echo "pre-commit: BLOCKED - the staged paths are not inside $FOSS_MCP_WORKER's write_paths," >&2
    echo "or it has no open dispatch. A worker sets FOSS_MCP_WORKER to its own card id." >&2
    exit 1
  fi
  exit 0
fi

if ! "$PY" ops/gatectl.py commit-guard; then
  echo >&2
  echo "pre-commit: BLOCKED - see gatectl commit-guard's output above." >&2
  echo "Stage explicit supervisor paths, or set FOSS_MCP_WORKER=<card id> if this IS" >&2
  echo "the worker committing its own card." >&2
  exit 1
fi
