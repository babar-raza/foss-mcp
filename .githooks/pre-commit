#!/usr/bin/env bash
# Refuses a supervisor commit that would sweep up a worker's uncommitted work.
#
# This is a HOOK and not a command because the command already existed, already
# printed the right refusal, and was chained past with `;` - twice. A control the
# operator can step over is a suggestion.
#
# Delegates to `gatectl commit-guard` rather than re-deriving the check here -
# two implementations of the same rule can drift, and one already did (this
# hook used to inline its own path check, separately from the command).
#
# Set FOSS_MCP_WORKER=1 in the worker's own environment: a worker committing its
# own product paths is exactly what should happen.
set -euo pipefail

if [ "${FOSS_MCP_WORKER:-0}" = "1" ]; then
  exit 0
fi

PY=".venv/Scripts/python.exe"
[ -x "$PY" ] || PY=".venv/bin/python"
[ -x "$PY" ] || PY="python"

if ! "$PY" ops/gatectl.py commit-guard; then
  echo >&2
  echo "pre-commit: BLOCKED - see gatectl commit-guard's output above." >&2
  echo "Stage explicit supervisor paths, or set FOSS_MCP_WORKER=1 if this IS" >&2
  echo "the worker committing its own card." >&2
  exit 1
fi
