#!/bin/sh
# POSIX sh on purpose, with an absolute shebang: `#!/usr/bin/env bash` searches PATH, and on a
# Windows host the first `bash` on PATH can be C:/Windows/System32/bash.exe, the WSL launcher. GitHub
# Desktop's bundled git ships sh.exe but no bash.exe, so there that launcher was the only candidate and
# every commit and push died with "WSL Relay ... execvpe(/bin/bash) failed" (found 2026-10-06).
# /bin/sh is resolved by git's own runtime, never by PATH. Keep this file POSIX (no pipefail, no [[ ]]).
# Blocks a push unless the local CI-equivalent passes.
#
# FAILS CLOSED, deliberately. The reference system's version of this hook matched
# the remote URL with a `case` and `exit 0`d on any non-match - which git reports
# as the hook PASSING, indistinguishable from success. A byte-for-byte copy of it
# pushed to a differently-named remote would silently run no checks at all. So
# here an unrecognised remote BLOCKS and asks, rather than waving the push
# through.
set -eu

# Fails closed if this clone's own LOCAL git config overrides user.email/user.name, or sets
# core.bare=true - see .githooks/pre-commit's own identical check for the full rationale
# (docs/DECISION_LOG.md's 2026-10-10 entry). Checked here too, independently, since a commit
# made with this repo's hooks bypassed (--no-verify) locally must still never reach the
# remote with a misattributed author.
if git config --local --get user.email >/dev/null 2>&1; then
  echo "pre-push: BLOCKED - this repo's LOCAL git config sets user.email (must never be set" >&2
  echo "pre-push: here - see .githooks/pre-commit's identical check). Run:" >&2
  echo "pre-push:   git config --unset user.email" >&2
  exit 1
fi
if git config --local --get user.name >/dev/null 2>&1; then
  echo "pre-push: BLOCKED - this repo's LOCAL git config sets user.name (same issue). Run:" >&2
  echo "pre-push:   git config --unset user.name" >&2
  exit 1
fi
if [ "$(git config --get core.bare 2>/dev/null || true)" = "true" ]; then
  echo "pre-push: BLOCKED - core.bare=true in this repo's own config (see .githooks/pre-commit)." >&2
  echo "pre-push:   git config core.bare false" >&2
  exit 1
fi

# Scrub repo-discovery env vars before anything below spawns a child process (PowerShell,
# bash, pytest) - an inherited GIT_DIR/GIT_WORK_TREE here is exactly the mechanism that let a
# test fixture's own throwaway `git init`/`git config` land in this repo's real, shared
# .git/config on 2026-10-10 (see docs/DECISION_LOG.md). This hook is the one place that class
# of leak could reach `scripts/ci_check.sh`'s own pytest run, so it is scrubbed at this exact
# boundary, in addition to (never instead of) the test suite's own conftest-level fix.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || true

# Refuse to publish any commit, in the range actually being pushed, authored or committed as
# anything but the one real identity - the last-line defense if a bad-identity commit was
# ever made with hooks bypassed (--no-verify) rather than caught at commit time above. Reads
# the ref-update lines git feeds this hook on stdin per its own pre-push protocol:
# "<local-ref> <local-sha> <remote-ref> <remote-sha>", one per line, one per pushed ref.
#
# The range is always "commits not already on some remote-tracking ref" (`--not --remotes`),
# never remote_sha..local_sha alone: a brand-new branch's update line has no remote_sha (all
# zeros), and remote_sha..local_sha with an empty remote_sha means "every ancestor of
# local_sha" - a full-history scan that would re-flag the already-tolerated, already-pushed
# 2026-10-10 bad-author commits still permanently in main's own history on every such push.
# `--not --remotes` instead only ever looks at commits genuinely new to the remote, regardless
# of which ref carries them in.
#
# %aE/%cE (mailmap-resolved), never %ae/%ce (raw): some already-made, still-unpushed commits
# predate this fix and carry a raw test@example.invalid/t@example.com identity that .mailmap
# already redeems to the real one for display - the explicit decision (docs/DECISION_LOG.md's
# 2026-10-10 entry) was to fix those via .mailmap, never by rewriting commits that are safe to
# rewrite only by accident of not being pushed yet. Reading raw emails here would re-litigate
# that decision by blocking the very push that was always going to carry them. A genuinely new
# bad-identity commit has no .mailmap entry, so %aE/%cE still catches it unresolved.
allowed_email="$(git config --global --get user.email || true)"
if [ -n "$allowed_email" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    bad="$(git log "$local_sha" --not --remotes --format='%H %aE %cE' 2>/dev/null | awk -v a="$allowed_email" '$2!=a || $3!=a {print}')"
    if [ -n "$bad" ]; then
      echo "pre-push: BLOCKED - commit(s) in $local_ref not authored/committed as $allowed_email:" >&2
      echo "$bad" >&2
      exit 1
    fi
  done
fi

remote_name="${1:-origin}"
remote_url="${2:-}"

case "$remote_url" in
  *foss-mcp*|*aspose-foss-dev-context-mcp*) ;;
  "")
    echo "pre-push: no remote URL supplied - refusing rather than assuming safe." >&2
    exit 1
    ;;
  *)
    echo "pre-push: remote '$remote_url' is not this project's own repository." >&2
    echo "pre-push: refusing. This hook fails CLOSED by design - a hook that exits 0" >&2
    echo "pre-push: on an unrecognised remote looks exactly like a hook that passed." >&2
    exit 1
    ;;
esac

echo "pre-push: running scripts/ci_check.sh before pushing to $remote_name"
# Run it with the bash that is running this hook. A bare `bash` on a Windows host resolves to the
# WSL launcher (C:\Windows\System32\bash.exe), which has no distribution here and fails without output,
# so every push was blocked by a launcher stub (found 2026-10-05). The same defect was fixed in gate exit.
#
# The repo toolchain (Go, Java, Node, ...) is on PATH only after scripts/toolchain/activate.ps1, which a
# GUI client such as GitHub Desktop never runs, so the Go/Java/TypeScript fixtures errored there for reasons
# unrelated to the code (found 2026-10-06). On Windows the hook therefore activates it itself, in a child
# PowerShell, and runs the CI check under the toolchain's own Git bash, which activation puts first on PATH.
PS="$(command -v powershell.exe 2>/dev/null || true)"
if [ -z "$PS" ] && [ -x /c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]; then
  PS=/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
fi
run_ci() {
  if [ -n "$PS" ] && [ -f scripts/toolchain/activate.ps1 ]; then
    "$PS" -NoProfile -ExecutionPolicy Bypass -Command '. ./scripts/toolchain/activate.ps1 *> $null; bash scripts/ci_check.sh; exit $LASTEXITCODE'
  else
    "${BASH:-bash}" scripts/ci_check.sh
  fi
}
if ! run_ci; then
  echo >&2
  echo "pre-push: scripts/ci_check.sh failed - push blocked." >&2
  exit 1
fi
