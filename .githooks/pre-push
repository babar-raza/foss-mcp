#!/usr/bin/env bash
# Blocks a push unless the local CI-equivalent passes.
#
# FAILS CLOSED, deliberately. The reference system's version of this hook matched
# the remote URL with a `case` and `exit 0`d on any non-match - which git reports
# as the hook PASSING, indistinguishable from success. A byte-for-byte copy of it
# pushed to a differently-named remote would silently run no checks at all. So
# here an unrecognised remote BLOCKS and asks, rather than waving the push
# through.
set -euo pipefail

remote_name="${1:-origin}"
remote_url="${2:-}"

case "$remote_url" in
  *foss-mcp*|*aspose-foss-dev-context-mcp*) ;;
  "")
    echo "pre-push: no remote URL supplied - refusing rather than assuming safe." >&2
    exit 1
    ;;
  *)
    echo "pre-push: remote '$remote_url' is not this project's own repository." >&2
    echo "pre-push: refusing. This hook fails CLOSED by design - a hook that exits 0" >&2
    echo "pre-push: on an unrecognised remote looks exactly like a hook that passed." >&2
    exit 1
    ;;
esac

echo "pre-push: running scripts/ci_check.sh before pushing to $remote_name"
# Run it with the bash that is running this hook. A bare `bash` on a Windows host resolves to the
# WSL launcher (C:\Windows\System32\bash.exe), which has no distribution here and fails without output,
# so every push was blocked by a launcher stub (found 2026-10-05). The same defect was fixed in gate exit.
if ! "${BASH:-bash}" scripts/ci_check.sh; then
  echo >&2
  echo "pre-push: scripts/ci_check.sh failed - push blocked." >&2
  exit 1
fi
