# Serving image: the MCP server, wired to serve exactly one product deployment.
#
# Two transports over ONE dispatch core (foss_mcp.mcp.server.create_server) - both
# entrypoints below call it, and neither re-implements tool dispatch. The default CMD keeps
# serving over stdio (unchanged since TC-018); docker-compose.yml overrides `command` to run
# infra/serve_http.py instead where a published port is needed. Never a THIRD implementation.
#
# Exactly one of the two build PATHS this project ships (the other is Dockerfile.ingestion).
# Do NOT add a third Dockerfile: an unreferenced alternate build is a confirmed crash-loop
# trap in the reference system, still sitting unused in its tree. A THIRD STAGE inside this
# same file is a different thing and is fine - see `demo` below, added deliberately rather
# than as a separate file for exactly that reason.
FROM python:3.13-slim@sha256:b92e6b9bb1ea9d826e9956fd8d30bf18bc384c130231d74fdf0ba3460c290b0b AS runtime

WORKDIR /app

# Hash-verified install: every dependency, and its transitive closure, is pinned by exact
# sha256 in requirements-serving.lock. --require-hashes refuses to install anything that
# isn't - there is no path from a compromised or substituted package to this image.
#
# Serving installs ONLY requirements-serving.lock (mcp plus its own transitive closure -
# anyio, starlette, pydantic, etc.), never the full requirements.lock: that file also
# carries dev/ops-only tooling (pytest, mypy, ruff) and extraction/ingestion-only
# dependencies (tree-sitter*) that this image never imports and must never ship.
COPY requirements-serving.lock ./requirements-serving.lock
RUN pip install --no-cache-dir --require-hashes -r requirements-serving.lock

# foss_mcp has no [build-system] in pyproject.toml (src/ layout only, per docs/REPOSITORY_LAYOUT.md);
# it is placed on PYTHONPATH rather than pip-installed, the same way tests/conftest.py does it locally.
COPY src/ ./src/
COPY config/ ./config/
COPY infra/serve_stdio.py ./infra/serve_stdio.py
COPY infra/serve_http.py ./infra/serve_http.py
COPY infra/fetch_product_reference.py ./infra/fetch_product_reference.py
COPY infra/fetch_recent_releases.py ./infra/fetch_recent_releases.py
COPY infra/verify_package_registry.py ./infra/verify_package_registry.py
ENV PYTHONPATH=/app/src

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin foss-mcp \
    && mkdir -p /data/manifests \
    && chown -R foss-mcp:foss-mcp /data
USER foss-mcp

# Documentary only for the stdio default (there is nothing listening to poll); real when
# docker-compose.yml overrides `command` to run infra/serve_http.py instead.
EXPOSE 8080

# Real readiness, not a bare import check: calls the running server's own /readyz endpoint
# (infra/serve_http.py), which is 200 only when the deployment's own scope names a real active
# generation (foss_mcp.mcp.health.is_ready) and 503 otherwise - never merely "the process
# accepts connections". This HEALTHCHECK is only meaningful when docker-compose.yml overrides
# `command` to run infra/serve_http.py (the stdio default below has nothing listening on 8080);
# it is unchanged for Dockerfile.ingestion's one-shot CLI, which is a different shape entirely.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8080/readyz', timeout=3).status==200 else 1)"]

CMD ["python", "/app/infra/serve_stdio.py"]

# Self-contained demo stage, built only when explicitly selected (`docker build --target
# demo`) - no `--build-context` flag required. Docker's default `docker build` with no
# --target always builds whichever stage is declared LAST, textually, in the Dockerfile - and
# `demo` must be declared as `FROM runtime AS demo` (it builds on top of runtime), which
# necessarily places it after `runtime`. Left alone, that would silently make `demo` the
# implicit default for every existing build/compose/Helm/CI path that never names a target.
# The trailing `FROM runtime` stage below (declared after `demo`, with no instructions of its
# own) re-anchors the Dockerfile's own last stage back to byte-identical `runtime` content, so
# the default `docker build` with no --target still produces exactly the `runtime` stage, and
# every path that never names a target is genuinely unaffected by this stage's existence.
#
# `infra/demo-manifests/` is committed to this repository (see docs/REPOSITORY_LAYOUT.md): the
# real, already-published, curated output of running build_chunks.py + ingest.py (+ the
# fetch_product_reference.py/verify_product_reference_install.py/fetch_recent_releases.py
# sidecar steps) locally, on whatever machine was updating it, for all 40 pilots - the same
# real scripts Dockerfile.ingestion runs inside a container, just run directly on the host
# instead, since GenerationManifestStore already namespaces every scope into its own
# subdirectory (src/foss_mcp/indexing/generation_manifest.py's own _scope_dir()), so many
# pilots' real output can share one tree with no collision. This is now a plain COPY from this
# repo's own default build context (no Buildx named build-context, no --build-context flag,
# nothing supplied only at build time): `docker build --target demo -t foss-mcp-serving:demo .`
# succeeds from git alone. The toolchain those scripts need (dotnet/node/java+maven/go/rust/g++,
# for the furnished-page pilots' live compile-verified examples) never enters this image at
# all - it only ever runs on whichever host machine is updating infra/demo-manifests/, exactly
# the same discipline Dockerfile.ingestion's own toolchain installs exist to serve, just
# without shipping that toolchain in a layer here. To refresh or add pilots, re-run the local
# ingestion pipeline and commit the updated infra/demo-manifests/ output through this same
# governed process (curating each scope down to its active_pointer.json and the one
# generation__*.json file it names).
#
# The result: a single image with every baked-in pilot's real generation already published,
# needing no PersistentVolumeClaim, no ingestion Job, and no startup wait for either - the
# existing `runtime` stage above (and everything that builds it, unchanged) is preserved
# exactly as it was for whatever still needs the live-ingestion architecture later.
FROM runtime AS demo
COPY --chown=foss-mcp:foss-mcp infra/demo-manifests/ /data/manifests

# Re-anchors the Dockerfile's own last stage back to runtime's exact content. Docker's
# default target (no --target) is always the LAST stage declared textually, and demo must
# be declared after runtime (it builds FROM it) - so without this trailing stage, a plain
# docker build with no --target would silently build demo instead of runtime. This
# stage adds no instructions of its own, so it is byte-identical to runtime.
FROM runtime
